# Copy to .env.local and fill in from the Stripe dashboard (test mode).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Supabase auth (Project Settings -> API). Both values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Supabase service-role key (Settings -> API Keys -> service_role / sb_secret_...).
# SECRET — server-side only; used by the Stripe webhook to record payments.
SUPABASE_SERVICE_ROLE_KEY=...

# Stripe webhook signing secret (Developers -> Webhooks -> your endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...
