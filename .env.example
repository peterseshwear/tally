# Supabase project connection. Get these from your Supabase project settings.
# Client-exposed (Vite only bundles VITE_-prefixed vars into the browser build):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (read via process.env in server middleware/functions, same values as above):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Logo.dev API key used by the Lovable "logo" connector to fetch company logos.
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=
